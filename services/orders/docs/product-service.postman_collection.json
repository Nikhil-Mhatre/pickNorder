              "raw": "{{baseUrl}}/api/categories/Bad_Slug!",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "Bad_Slug!"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Validation error status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error response format\", () => { const body=pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.error.code).to.eql(\"VALIDATION_ERROR\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
