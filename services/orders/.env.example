# General
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=verify-full&sslaccept=strict"
# When switching To AWS RDS use following url
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require&sslrootcert=certs/global-bundle.pem"

# Kafka
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=picknorder-orders-service
KAFKA_BROKERS=your-broker-host:your-port

# Authentication
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=your-service-username
KAFKA_SASL_PASSWORD=your-service-password

# TLS
KAFKA_SSL=true
KAFKA_CA_PATH=./certs/ca.pem
