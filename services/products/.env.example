# General
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=verify-full&sslaccept=strict"
# When switching To AWS RDS use following url
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require&sslrootcert=certs/global-bundle.pem"

# Kafka
KAFKA_ENABLED=true
KAFKA_BROKERS=
KAFKA_CLIENT_ID=product-service
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_IDENTITY_TOPIC=product.events
KAFKA_CA_CERT_PATH=
