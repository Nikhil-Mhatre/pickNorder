// use prisma-8

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id          String             @id @onCreate(cuid(2))
  name        String             @unique
  slug        String             @unique
  description String?
  products    Product[]

  createdAt   DateTime           @default(now())
  updatedAt   temporal.UpdatedAt

  @@index([name])
}


model Product {
  id          String                           @id @onCreate(cuid(2))
  name        String
  description String?
  price       Decimal(precision: 10, scale: 2)
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)

  categoryId  String
  category    Category                         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt   DateTime                         @default(now())
  updatedAt   temporal.UpdatedAt

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([price])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String

  processedAt DateTime @default(now())

  @@index([eventType])
}
