{
  "name": "picknorder",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:product": "pnpm --filter @picknorder/product-service dev",
    "build:product": "pnpm --filter @picknorder/product-service build",
    "start:product": "pnpm --filter @picknorder/product-service start",
    "db:generate:product": "pnpm --filter @picknorder/product-service db:generate",
    "db:migrate:product": "pnpm --filter @picknorder/product-service db:migrate",
    "db:seed:product": "pnpm --filter @picknorder/product-service db:seed",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "lint:product": "pnpm --filter @picknorder/product-service lint",
    "lint:fix:product": "pnpm --filter @picknorder/product-service lint:fix",
    "format:product": "pnpm --filter @picknorder/product-service format",
    "format:check:product": "pnpm --filter @picknorder/product-service format:check",
    "typecheck:product": "pnpm --filter @picknorder/product-service typecheck",
    "test:product": "pnpm --filter @picknorder/product-service test",
    "dev:web": "pnpm --filter @picknorder/web dev",
    "build:web": "pnpm --filter @picknorder/web build",
    "start:web": "pnpm --filter @picknorder/web start"
  }
}
